<% content_for :title, t(".title") %>

<h1><%= t(".heading") %></h1>

<%= form_with model: @user, url: password_path, method: :patch do |form| %>
  <% if @user.errors.any? %>
    <div class="form-errors">
      <p class="form-errors__title"><%= t(".error_heading") %></p>
      <ul class="form-errors__list">
        <% @user.errors.full_messages.each do |message| %>
          <li class="form-errors__item"><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :password_challenge %><br>
    <%= form.password_field :password_challenge, required: true, autofocus: true,
          autocomplete: "current-password", maxlength: 72, value: nil %>
  </div>

  <div>
    <%= form.label :password, t(".new_password") %><br>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    <span><%= t(".password_hint", count: User::MINIMUM_PASSWORD_LENGTH) %></span>
  </div>

  <div>
    <%= form.label :password_confirmation, t(".new_password_confirmation") %><br>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <%= form.submit t(".submit") %>
<% end %>

<p><%= link_to t(".back"), profile_path %></p>
